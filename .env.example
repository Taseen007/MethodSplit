# Copy this file to .env before running `make up`.

# --- Postgres ---
POSTGRES_USER=methodsplit
POSTGRES_PASSWORD=methodsplit_dev_password
POSTGRES_DB=methodsplit
REPLICATOR_PASSWORD=replicator_dev_password

PG_PRIMARY_DSN=postgres://methodsplit:methodsplit_dev_password@pg-primary:5432/methodsplit?sslmode=disable
PG_REPLICA_DSN=postgres://methodsplit:methodsplit_dev_password@pg-replica:5432/methodsplit?sslmode=disable

# --- Redis ---
REDIS_ADDR=redis:6379

# --- Gateway ---
GATEWAY_ADDR=:8080
GATEWAY_CONFIG=/app/configs/gateway.yaml
MERCHANTS_CONFIG=/app/configs/merchants.yaml

# --- Payments API ---
PAYMENTS_ADDR=:9000

# --- ML ---
ML_MODEL_PATH=/app/models/iforest-v1.json
ML_MODE=off

# --- Observability ---
GRAFANA_ADMIN_PASSWORD=admin
