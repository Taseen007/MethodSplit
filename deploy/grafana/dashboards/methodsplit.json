{
  "title": "MethodSplit Gateway",
  "uid": "methodsplit-gateway",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Requests/sec by class + pool",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(ms_requests_total[1m])) by (class, pool)",
          "legendFormat": "{{class}}/{{pool}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Request duration p95 by class",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(ms_request_duration_seconds_bucket[1m])) by (le, class))",
          "legendFormat": "{{class}} p95"
        }
      ]
    },
    {
      "id": 3,
      "title": "Cache hit ratio",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(ms_cache_total{result=\"hit\"}[5m])) / sum(rate(ms_cache_total[5m]))",
          "legendFormat": "hit ratio"
        }
      ]
    },
    {
      "id": 4,
      "title": "Rate-limit rejections (429) by limit",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(ms_ratelimit_rejected_total[1m])) by (limit)",
          "legendFormat": "{{limit}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Idempotency results",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum(rate(ms_idempotency_total[1m])) by (result)",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Upstream health",
      "type": "state-timeline",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "ms_upstream_healthy",
          "legendFormat": "{{pool}}/{{target}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Redis fail-open events",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        {
          "expr": "sum(rate(ms_redis_failopen_total[5m]))",
          "legendFormat": "fail-open/s"
        }
      ]
    },
    {
      "id": 8,
      "title": "ML flagged clients by mode",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [
        {
          "expr": "sum(rate(ms_ml_flagged_total[5m])) by (mode)",
          "legendFormat": "{{mode}}"
        }
      ]
    }
  ]
}
